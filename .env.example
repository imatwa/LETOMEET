# Copy values into your environment. This file is NOT loaded automatically.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Explicit local testing only. Never enable in production.
MAIL_MODE=console
# Production mail (STARTTLS, authenticated SMTP):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional administrator, must verify mailbox through login:
ADMIN_EMAIL=
ADMIN_NAME=LETOMEET Admin
# Default: SQLite instance/school.db
# DATABASE_URL=postgresql+psycopg://user:password@host/database
# Optional directory for reading pre-update local photos only; new photos use the database
# UPLOAD_FOLDER=
